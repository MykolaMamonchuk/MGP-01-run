// ЗАПІКАННЯ ВІЗЕРУНКА ВОДИ. Не новий вигляд, а той самий — просто порахований один раз.
//
// НАВІЩО. Заміряно наживо на пляжі (Redmi 8A, рівень 9): кадр 159 мс із цим візерунком і
// 47 мс, якщо воду залишити звичайним матеріалом. Уся різниця — `_waterlayer()`, а це
// СІМДЕСЯТ П'ЯТЬ викликів `_circ` на КОЖЕН піксель води, плюс `_fbm`. У лісі вода займає
// кілька відсотків екрана й коштує 1,7 мс; на пляжі — пів кадру й коштує 112 мс. Ціна тут
// завжди за пікселі.
//
// ЧОМУ ЦЕ МОЖНА ЗАПЕКТИ. `_waterlayer()` починається з `uv = mod(uv, 1.0)`, тобто візерунок
// ІДЕАЛЬНО ПЛИТКОВИЙ з періодом 1. Отже його значення залежить лише від дробової частини
// координати, і текстура 512×512 з увімкненим повторенням дає РІВНО те саме число, що й
// сімдесят п'ять кружечків — але за одну вибірку. Текстура без освітлення коштує нуль
// (перевірено стендом), математика на піксель — усе.
//
// Канал R — `_waterlayer`, канал G — `_fbm` (теж плитковий, бо ми беремо його від mod uv).
shader_type canvas_item;
render_mode unshaded;

const float M_2PI = 6.283185307;
const float M_6PI = 18.84955592;

float _random(vec2 uv) {
	return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453123);
}

float _noise(vec2 uv) {
	vec2 i = floor(uv);
	vec2 f = fract(uv);
	float a = _random(i);
	float b = _random(i + vec2(1.0, 0.0));
	float c = _random(i + vec2(0.0, 1.0));
	float d = _random(i + vec2(1.0, 1.0));
	vec2 u = smoothstep(0.0, 1.0, f);
	return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

float _fbm(vec2 uv) {
	float amp = 0.5;
	float freq = 3.0;
	float v = 0.0;
	for (int i = 0; i < 3; i++) {
		v += amp * _noise(freq * uv);
		amp *= 0.5;
		freq *= 2.0;
	}
	return v;
}

float _circ(vec2 pos, vec2 c, float s) {
	c = abs(pos - c);
	c = min(c, 1.0 - c);
	return smoothstep(0.0, 0.002, sqrt(s) - sqrt(dot(c, c))) * -1.0;
}

float _waterlayer(vec2 uv) {
	uv = mod(uv, 1.0);
	float ret = 1.0;
	ret += _circ(uv, vec2(0.37378, 0.277169), 0.0268181);
	ret += _circ(uv, vec2(0.0317477, 0.540372), 0.0193742);
	ret += _circ(uv, vec2(0.430044, 0.882218), 0.0232337);
	ret += _circ(uv, vec2(0.641033, 0.695106), 0.0117864);
	ret += _circ(uv, vec2(0.0146398, 0.0791346), 0.0299458);
	ret += _circ(uv, vec2(0.43871, 0.394445), 0.0289087);
	ret += _circ(uv, vec2(0.909446, 0.878141), 0.028466);
	ret += _circ(uv, vec2(0.310149, 0.686637), 0.0128496);
	ret += _circ(uv, vec2(0.928617, 0.195986), 0.0152041);
	ret += _circ(uv, vec2(0.0438506, 0.868153), 0.0268601);
	ret += _circ(uv, vec2(0.308619, 0.194937), 0.00806102);
	ret += _circ(uv, vec2(0.349922, 0.449714), 0.00928667);
	ret += _circ(uv, vec2(0.0449556, 0.953415), 0.023126);
	ret += _circ(uv, vec2(0.117761, 0.503309), 0.0151272);
	ret += _circ(uv, vec2(0.563517, 0.244991), 0.0292322);
	ret += _circ(uv, vec2(0.566936, 0.954457), 0.00981141);
	ret += _circ(uv, vec2(0.0489944, 0.200931), 0.0178746);
	ret += _circ(uv, vec2(0.569297, 0.624893), 0.0132408);
	ret += _circ(uv, vec2(0.298347, 0.710972), 0.0114426);
	ret += _circ(uv, vec2(0.878141, 0.771279), 0.00322719);
	ret += _circ(uv, vec2(0.150995, 0.376221), 0.00216157);
	ret += _circ(uv, vec2(0.119673, 0.541984), 0.0124621);
	ret += _circ(uv, vec2(0.629598, 0.295629), 0.0198736);
	ret += _circ(uv, vec2(0.334357, 0.266278), 0.0187145);
	ret += _circ(uv, vec2(0.918044, 0.968163), 0.0182928);
	ret += _circ(uv, vec2(0.965445, 0.505026), 0.006348);
	ret += _circ(uv, vec2(0.514847, 0.865444), 0.00623523);
	ret += _circ(uv, vec2(0.710575, 0.0415131), 0.00322689);
	ret += _circ(uv, vec2(0.71403, 0.576945), 0.0215641);
	ret += _circ(uv, vec2(0.748873, 0.413325), 0.0110795);
	ret += _circ(uv, vec2(0.0623365, 0.896713), 0.0236203);
	ret += _circ(uv, vec2(0.980482, 0.473849), 0.00573439);
	ret += _circ(uv, vec2(0.647463, 0.654349), 0.0188713);
	ret += _circ(uv, vec2(0.651406, 0.981297), 0.00710875);
	ret += _circ(uv, vec2(0.428928, 0.382426), 0.0298806);
	ret += _circ(uv, vec2(0.811545, 0.62568), 0.00265539);
	ret += _circ(uv, vec2(0.400787, 0.74162), 0.00486609);
	ret += _circ(uv, vec2(0.331283, 0.418536), 0.00598028);
	ret += _circ(uv, vec2(0.894762, 0.0657997), 0.00760375);
	ret += _circ(uv, vec2(0.525104, 0.572233), 0.0141796);
	ret += _circ(uv, vec2(0.431526, 0.911372), 0.0213234);
	ret += _circ(uv, vec2(0.658212, 0.910553), 0.000741023);
	ret += _circ(uv, vec2(0.514523, 0.243263), 0.0270685);
	ret += _circ(uv, vec2(0.0249494, 0.252872), 0.00876653);
	ret += _circ(uv, vec2(0.502214, 0.47269), 0.0234534);
	ret += _circ(uv, vec2(0.693271, 0.431469), 0.0246533);
	ret += _circ(uv, vec2(0.415, 0.884418), 0.0271696);
	ret += _circ(uv, vec2(0.149073, 0.41204), 0.00497198);
	ret += _circ(uv, vec2(0.533816, 0.897634), 0.00650833);
	ret += _circ(uv, vec2(0.0409132, 0.83406), 0.0191398);
	ret += _circ(uv, vec2(0.638585, 0.646019), 0.0206129);
	ret += _circ(uv, vec2(0.660342, 0.966541), 0.0053511);
	ret += _circ(uv, vec2(0.513783, 0.142233), 0.00471653);
	ret += _circ(uv, vec2(0.124305, 0.644263), 0.00116724);
	ret += _circ(uv, vec2(0.99871, 0.583864), 0.0107329);
	ret += _circ(uv, vec2(0.894879, 0.233289), 0.00667092);
	ret += _circ(uv, vec2(0.246286, 0.682766), 0.00411623);
	ret += _circ(uv, vec2(0.0761895, 0.16327), 0.0145935);
	ret += _circ(uv, vec2(0.949386, 0.802936), 0.0100873);
	ret += _circ(uv, vec2(0.480122, 0.196554), 0.0110185);
	ret += _circ(uv, vec2(0.896854, 0.803707), 0.013969);
	ret += _circ(uv, vec2(0.292865, 0.762973), 0.00566413);
	ret += _circ(uv, vec2(0.0995585, 0.117457), 0.00869407);
	ret += _circ(uv, vec2(0.377713, 0.00335442), 0.0063147);
	ret += _circ(uv, vec2(0.506365, 0.531118), 0.0144016);
	ret += _circ(uv, vec2(0.408806, 0.894771), 0.0243923);
	ret += _circ(uv, vec2(0.143579, 0.85138), 0.00418529);
	ret += _circ(uv, vec2(0.0902811, 0.181775), 0.0108896);
	ret += _circ(uv, vec2(0.780695, 0.394644), 0.00475475);
	ret += _circ(uv, vec2(0.298036, 0.625531), 0.00325285);
	ret += _circ(uv, vec2(0.218423, 0.714537), 0.00157212);
	ret += _circ(uv, vec2(0.658836, 0.159556), 0.00225897);
	ret += _circ(uv, vec2(0.987324, 0.146545), 0.0288391);
	ret += _circ(uv, vec2(0.222646, 0.251694), 0.00092276);
	ret += _circ(uv, vec2(0.159826, 0.528063), 0.00605293);
	return max(ret, 0.0);
}

// ВАРІАНТИ ВІЗЕРУНКА. Чотири різні текстури замість однієї, щоб море й кожен канал мали
// свій малюнок — інакше вся вода в грі однакова.
//
// Перетворення підібрані так, щоб НЕ ЗЛАМАТИ ПЛИТКОВІСТЬ. Візерунок плитковий із періодом
// 1 (`_waterlayer` починається з `mod(uv, 1.0)`), і це зберігають лише: зсув, дзеркалення
// та ЦІЛЕ масштабування. Поворот — ні: після нього на стиках сусідніх плиток з'явиться шов.
uniform vec2 uv_offset = vec2(0.0);
uniform vec2 uv_flip = vec2(1.0);
uniform float uv_scale = 1.0;

void fragment() {
	vec2 uv = mod(UV * uv_scale * uv_flip + uv_offset, 1.0);
	COLOR = vec4(_waterlayer(uv), _fbm(uv), 0.0, 1.0);
}
