func _row_seed_for(dist_m: float) -> int:
	var key := "%s|%d" % [String(world.get("id", "")), roundi(dist_m / ROW_DEPTH)]
	_row_rng.seed = hash(key)
	return _row_rng.randi_range(0, 1 << 29)


