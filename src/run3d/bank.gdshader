// Берег каналу, що з відстанню зливається з травою.
//
// Навіщо. Берег — смуга завширшки 18 см уздовж усього каналу. Вдалині її видно під гострим
// кутом, і вона займає менше пікселя: щокадру то потрапляє в піксель, то ні. Око бачить це
// як миготіння зеленого з коричневим саме по лінії берега — рівно те, що позначив замовник.
//
// Що НЕ допомогло (заміряно 17.09.2026 на детермінованому прогоні, кадри 400/401 рівня 1,
// у рамках із знімка замовника; база 14585 пікселів, що перескакують зелене↔коричневе):
//   MSAA 8×                 12419  (−15%)
//   смуга ширша вдвічі      12011  (−18%)
//   прибрати берег зовсім    4981
//   ПЕРЕФАРБУВАТИ в колір трави, геометрію не чіпати  3570  ← менше, ніж зовсім без берега
// Тобто мерехтить не геометрія, а КОНТРАСТ. Пікселю завширшки менше за один однаково, яка
// там форма; важливо лише, наскільки різні два кольори, між якими він стрибає.
//
// Рішення. Зблизька, де смуга займає багато пікселів і мерехтіти не може, берег лишається
// піщаним — саме таким його й малювали. Далі колір плавно йде в колір трави, і на відстані,
// де починається недосемплення, стрибати вже нема між чим.
shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 near_color : source_color;
uniform vec4 far_color : source_color;
// Межі переходу — у метрах від камери.
uniform float fade_start = 6.0;
uniform float fade_end = 22.0;

void fragment() {
	// VERTEX у фрагментному шейдері Godot — позиція у просторі виду, тож це просто відстань.
	float d = length(VERTEX);
	ALBEDO = mix(near_color.rgb, far_color.rgb, smoothstep(fade_start, fade_end, d));
	ROUGHNESS = 1.0;
}
