## Виріз камери й заокруглені кути телефона.
##
## До 17.09.2026 проєкт не обробляв безпечну зону ЖОДНИМ рядком — при тому, що ціль це
## мобільні додатки. На айфоні з «острівцем» серця й лічильник злитків (лівий верх) та кнопка
## паузи (правий верх) лягли б просто під виріз, а кнопка сили — під смужку жесту внизу.
## Побачити це можна лише на справжньому пристрої з чубчиком, тобто коли вже пізно.
##
## Тому обчислення відступів винесене в ЧИСТУ функцію: DisplayServer у тесті не підробиш,
## а перевірити треба саме арифметику переведення пікселів вікна в одиниці полотна — розтяг
## "expand" роздає базові 1280×720 по більшій осі, тож вони НЕ збігаються.
extends GutTest

## hud.gd не має глобального class_name, тож беремо сам скрипт — статичну функцію можна
## кликати просто на ньому.
const HudScript = preload("res://src/ui/hud.gd")


## Телефон без вирізу: безпечна область дорівнює вікну — не чіпаємо нічого.
func test_no_notch_means_no_padding() -> void:
	var win := Vector2i(1170, 2532)
	var pad := HudScript.safe_area_insets(Rect2i(0, 0, 1170, 2532), win, Vector2(1170, 2532))
	assert_eq(pad, Vector4.ZERO, "без вирізу HUD не звужується")


## Айфон з «острівцем»: зверху 132 пікселі під виріз, знизу 102 під смужку жесту.
func test_notch_and_home_bar_become_padding() -> void:
	var win := Vector2i(1170, 2532)
	var safe := Rect2i(0, 132, 1170, 2532 - 132 - 102)
	var pad := HudScript.safe_area_insets(safe, win, Vector2(1170, 2532))
	assert_eq(pad.y, 132.0, "згори відступ рівно під виріз")
	assert_eq(pad.w, 102.0, "знизу — під смужку жесту")
	assert_eq(pad.x, 0.0, "ліворуч нічого не з'їдаємо")
	assert_eq(pad.z, 0.0, "праворуч теж")


## Головне, заради чого функція чиста: полотно гри НЕ дорівнює вікну. Розтяг "expand"
## роздає базові 1280×720 по більшій осі, тож 132 пікселі вікна — це інша величина на полотні.
func test_pixels_are_converted_into_canvas_units() -> void:
	var win := Vector2i(2340, 1080)          # телефон боком
	var canvas := Vector2(1560, 720)          # полотно гри при такому екрані
	var safe := Rect2i(132, 0, 2340 - 132, 1080)
	var pad := HudScript.safe_area_insets(safe, win, canvas)
	assert_almost_eq(pad.x, 132.0 * (1560.0 / 2340.0), 0.01,
		"відступ переведено в одиниці полотна, а не лишено в пікселях вікна")


## Система інколи віддає дурню — порожню або нульову область. Краще не зробити нічого,
## ніж з'їсти пів екрана: гра має лишитись іграбельною навіть на дивному пристрої.
func test_nonsense_from_the_system_is_ignored() -> void:
	assert_eq(HudScript.safe_area_insets(Rect2i(0, 0, 0, 0), Vector2i(1170, 2532), Vector2(1170, 2532)),
		Vector4.ZERO, "порожня безпечна область — не звужуємо")
	assert_eq(HudScript.safe_area_insets(Rect2i(0, 0, 100, 100), Vector2i(0, 0), Vector2(1280, 720)),
		Vector4.ZERO, "нульове вікно — не ділимо на нуль")


## Відступи ніколи не від'ємні: безпечна область, більша за вікно, не сміє РОЗСУНУТИ HUD
## за межі екрана.
func test_padding_is_never_negative() -> void:
	var pad := HudScript.safe_area_insets(Rect2i(-50, -50, 2000, 3000), Vector2i(1170, 2532),
		Vector2(1170, 2532))
	assert_gte(pad.x, 0.0)
	assert_gte(pad.y, 0.0)
	assert_gte(pad.z, 0.0)
	assert_gte(pad.w, 0.0)
