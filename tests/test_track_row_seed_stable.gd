## Регресія на "миготіння на горизонті" (src/run3d/track.gd, Track._decorate()).
##
## Вада: ряд — кільцевий буфер, і при кожному перевертанні (голова траси) отримував НОВЕ
## випадкове зерно (_row_seed[i] = _rng.randi_range(...)). Той самий відрізок дороги через це
## щоразу виглядав інакше: малюнок плиток покриття й напуск трави на краю (обидва рахуються
## від _row_seed через hash() у _paint_surface_row()/_sync_road()) плавали щоразу заново.
##
## Правильно: зерно ряду — ЧИСТА функція АБСОЛЮТНОЇ ВІДСТАНІ ділянки (Track._row_seed_for()),
## а не жереб. Цей тест жене трасу через ПОВНИЙ цикл кільцевого буфера (ROWS перевертань —
## кожен ряд перевертається щонайменше раз), а тоді примусово повертає один і той самий ряд
## до ТІЄЇ САМОЇ абсолютної відстані і перевіряє, що зерно не змінилось. На старому коді
## (жереб із спільного _rng) це падало майже напевно: між двома викликами _decorate() для
## цього ряду відбувається ROWS decorate-викликів для інших рядів, а кожен з них тягне з _rng
## купу randf()/randi() для пропсів і забудови — стан _rng встигає піти зовсім не туди.
##
## НЕ порівнюємо два окремі ЗАПУСКИ (це навмисно неможливо чесно зміряти — вода/декор/хмари
## живуть за реальним часом). Тут один запуск: forced _decorate() того самого ряду двічі.
extends GutTest

var _track: Track


func _world(name: String) -> Dictionary:
	var f := FileAccess.open("res://data/worlds/%s.json" % name, FileAccess.READ)
	var parsed = JSON.parse_string(f.get_as_text())
	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}


func before_each() -> void:
	_track = Track.new()
	add_child_autofree(_track)
	await wait_process_frames(2)
	_track.rebuild(_world("meadow"), false)


## Головна регресія: та сама абсолютна відстань — те саме зерно, навіть після повного циклу
## кільцевого буфера (усі ROWS рядів перевернулись хоч раз між двома decorate() ЦЬОГО ряду).
func test_row_seed_survives_full_wrap_cycle() -> void:
	var row := _track._rows[0]
	# зерно ряду для ПОТОЧНОЇ (щойно розкладеної rebuild()) відстані
	var d0: float = _track._row_distance_m[0]
	var seed_before: int = _track._row_seed[0]
	assert_eq(_track._row_seed_for(d0), seed_before,
		"зерно щойно розкладеного ряду мусить збігатися з чистою функцією його відстані")

	# повний цикл кільцевого буфера: ROWS метрів ходу — кожен ряд перевертається щонайменше
	# раз, і на кожному перевертанні _decorate() інших рядів тягне купу randf()/randi() з
	# спільного _rng (пропси, забудова другого плану, каміння в каналі тощо).
	for _n in range(Track.ROWS):
		_track.advance(1.0)

	# примусово повертаємо САМЕ ЦЕЙ ряд до ТІЄЇ САМОЇ абсолютної відстані d0, що й була —
	# наче ту саму ділянку дороги розкладають ще раз, — і перевіряємо зерно.
	_track.distance_m = d0 + 5000.0
	row.position.z = 5000.0   # distance_m - position.z == d0, точнісінько як було
	_track._decorate(row)

	assert_eq(_track._row_seed[0], seed_before,
		"та сама ділянка дороги мусить лишатись тим самим зерном, коли ряд перевертається знову")
	assert_eq(_track._row_distance_m[0], d0, "контроль: примусова відстань справді збіглась")


## Зерно ряду не залежить ВІД ТОГО, ЯКИЙ саме ряд-вузол чи момент часу його порахував —
## лише від відстані й світу. Перевіряємо це напряму через чисту функцію.
func test_row_seed_for_is_pure_function_of_distance() -> void:
	assert_eq(_track._row_seed_for(123.0), _track._row_seed_for(123.0),
		"один і той самий виклик з тією самою відстанню — той самий результат")
	# округлення до ROW_DEPTH: відстані в межах одного ряду мають те саме зерно
	assert_eq(_track._row_seed_for(40.1), _track._row_seed_for(40.4),
		"відстані в межах одного й того самого ряду (ROW_DEPTH=1 м) дають те саме зерно")


## Різні ділянки дороги (різна округлена відстань) — різне зерно: чиста функція не має
## вироджуватись в одну константу для всієї траси.
func test_row_seed_for_varies_across_distance() -> void:
	var seeds := {}
	for i in range(20):
		seeds[_track._row_seed_for(float(i) * Track.ROW_DEPTH)] = true
	assert_gt(seeds.size(), 15, "20 сусідніх ділянок мають давати помітно різні зерна")
